# Copy this file to .env. Local Python and Docker Compose both read that file.
# Never commit the populated .env file. Keep each real value in one place only.

# Application
ENVIRONMENT=development
PORT=8000
# Go migration aliases. Leave empty until the Go entry service is introduced.
APP_ENV=
HTTP_ADDR=
DASHSCOPE_API_KEY=replace-with-a-new-key
TAVILY_API_KEY=
SENIVERSE_API_KEY=
LLM_MODEL_NAME=deepseek-v3.2
HF_ENDPOINT=https://hf-mirror.com

# PostgreSQL
POSTGRES_DB=agent_db
POSTGRES_USER=qidian_agent
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit override for local Python. When empty, the application
# constructs the URL from the POSTGRES_* variables above.
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0
