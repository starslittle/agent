# Copy this file to .env. Local Python and Docker Compose both read that file.
# Never commit the populated .env file. Keep each real value in one place only.

# Application
ENVIRONMENT=development
PORT=8000
# Go gateway. APP_ENV overrides the legacy ENVIRONMENT value; HTTP_ADDR
# overrides the legacy PORT value. Compose fixes the internal address to
# :8000, while PORT controls only the host-side published port.
APP_ENV=development
HTTP_ADDR=:8000
PYTHON_BASE_URL=http://127.0.0.1:8000
MAX_REQUEST_BYTES=1048576
UPSTREAM_HEADER_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_TTL=168h
INTERNAL_AGENT_SECRET=replace-with-at-least-32-random-characters
DASHSCOPE_API_KEY=replace-with-a-new-key
TAVILY_API_KEY=
SENIVERSE_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash
HF_ENDPOINT=https://hf-mirror.com

# PostgreSQL
POSTGRES_DB=agent_db
POSTGRES_USER=qidian_agent
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional explicit override for local Python. When empty, the application
# constructs the URL from the POSTGRES_* variables above.
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0
