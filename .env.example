# Copy this file to .env for Go and Docker Compose. For a Python-only local
# process, copy the Agent-related values to backend/.env or export them.
# Never commit the populated .env file. Keep each real value in one place only.

# Application
ENVIRONMENT=development
PORT=8000
# Go gateway. APP_ENV overrides the legacy ENVIRONMENT value; HTTP_ADDR
# overrides the legacy PORT value. Compose fixes the internal address to
# :8000, while PORT controls only the host-side published port.
APP_ENV=development
HTTP_ADDR=:8000
PYTHON_BASE_URL=http://127.0.0.1:8000
AGENT_PROTOCOL_MODE=v1
AGENT_RUN_DEADLINE=5m
AGENT_CANCEL_TIMEOUT=5s
AGENT_RECONCILE_TIMEOUT=5s
AGENT_SERVICE_VERSION=dev
AGENT_RUNTIME_RETENTION_SECONDS=1800
# 本地轻量默认。生产切换 postgres 前按上线手册完成备份、schema、grant 与审核。
AGENT_RUNTIME_STORE=memory
AGENT_RUNTIME_DATABASE_URL=
AGENT_RUNTIME_LEASE_SECONDS=30
AGENT_RUNTIME_EVENT_POLL_SECONDS=0.25
# 仅迁移/单副本开发时自动执行 LangGraph checkpoint setup。
AGENT_RUNTIME_CHECKPOINT_SETUP=false
AGENT_RUNTIME_COORDINATION=none
AGENT_RUNTIME_REDIS_CHANNEL_PREFIX=qidian:agent-runtime
AGENT_RUNTIME_MAINTENANCE_SECONDS=300
AGENT_MAX_REQUEST_BYTES=1048576
# Python 只有这一套执行引擎；Legacy/V1 只是 Go/Python 传输协议差异。
AGENT_EXECUTION_ENGINE=langgraph_v1
APP_TIMEZONE=Asia/Shanghai
MAX_REQUEST_BYTES=1048576
UPSTREAM_HEADER_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_TTL=168h
INTERNAL_AGENT_SECRET=replace-with-at-least-32-random-characters
DASHSCOPE_API_KEY=replace-with-a-new-key
MODEL_PROVIDER=dashscope_openai
# 百炼北京地域公共 OpenAI-compatible 地址；Workspace/其他地域按控制台替换。
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_REQUEST_TIMEOUT_SECONDS=120
TAVILY_API_KEY=
LLM_MODEL_NAME=deepseek-v4-flash

# PostgreSQL（Go 独占 app_core 写入；Python 仅写 agent_runtime schema）
POSTGRES_DB=agent_db
POSTGRES_USER=qidian_agent
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Local-only Adminer web UI exposed by docker-compose.dev.yml.
ADMINER_PORT=8082
# Optional shared connection override. Python Agent Service does not write
# business user, conversation, message or product Run tables.
DATABASE_URL=

# Redis 仅用于 Runtime 跨副本通知；PostgreSQL 始终是运行事实与回放来源。
REDIS_URL=redis://localhost:6379/0
